‎<!DOCTYPE html>
‎<html lang="bn">
‎<head>
‎<meta charset="UTF-8">
‎<meta name="viewport" content="width=device-width, initial-scale=1.0">
‎<title>আমার প্রতিষ্ঠান — Demo</title>
‎<style>
‎:root{
‎  --navy:#0b2340; --blue:#1769e0; --green:#13a56b; --bg:#f6f8fc;
‎  --text:#10233d; --muted:#66758a; --card:#fff; --line:#e7edf5;
‎}
‎*{box-sizing:border-box}
‎body{margin:0;font-family:Arial,"Noto Sans Bengali",sans-serif;background:var(--bg);color:var(--text)}
‎a{text-decoration:none;color:inherit}
‎.container{max-width:1180px;margin:auto;padding:0 18px}
‎header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
‎.nav{height:68px;display:flex;align-items:center;justify-content:space-between;gap:16px}
‎
‎/* ব্র্যান্ড ও লোগো লেআউট */
‎.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px;text-decoration:none}
‎.logo-mark{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#1769e0,#13a56b);color:white;display:grid;place-items:center;font-size:21px;flex-shrink:0;overflow:hidden}
‎.logo-mark img{width:100%;height:100%;object-fit:cover}
‎
‎/* নেভিগেশন ও বাটনসমূহ */
‎.nav-right{display:flex;align-items:center;gap:14px}
‎.navlinks{display:flex;gap:20px;font-size:14px;color:#4c5d73}
‎.btn{border:0;border-radius:10px;padding:10px 16px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
‎.btn-primary{background:var(--blue);color:#fff}
‎
‎/* ভাষা সুইচ ও সাইজ ঠিক করা নাইট মোড বাটন */
‎.lang-switch{border:1px solid #d9e2ed;background:#fff;color:var(--text);border-radius:8px;padding:6px 8px;font-size:12px;font-weight:700;cursor:pointer;outline:none;height:36px}
‎.theme-toggle{background:#eef3f9;color:#10233d;border:1px solid #d9e2ed;border-radius:8px;width:36px;height:36px;min-width:36px;display:grid;place-items:center;font-size:15px;line-height:1;font-weight:800;cursor:pointer;padding:0}
‎
‎.hero{background:linear-gradient(135deg,#0b2340,#123f73);color:#fff;padding:64px 0 54px}
‎.hero-inner{text-align:center}
‎.badge{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);padding:7px 12px;border-radius:30px;font-size:12px}
‎h1{font-size:42px;line-height:1.2;margin:18px auto 10px;max-width:800px}
‎.hero p{color:#dce8f7;margin:0 auto 26px;max-width:650px}
‎.searchbox{background:#fff;padding:9px;border-radius:15px;display:flex;gap:8px;max-width:850px;margin:auto;box-shadow:0 15px 40px rgba(0,0,0,.18)}
‎.searchbox select,.searchbox input{border:1px solid var(--line);padding:14px;border-radius:10px;min-width:0;font-size:14px;outline:none}
‎.searchbox select{width:25%}.searchbox input{flex:1}.searchbox button{width:120px}
‎.quick{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-top:18px}
‎.quick span{font-size:12px;border:1px solid rgba(255,255,255,.2);padding:7px 11px;border-radius:20px;color:#e8f1ff}
‎section{padding:48px 0}
‎.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:20px}
‎.section-head h2{margin:0;font-size:26px}.section-head p{margin:5px 0 0;color:var(--muted);font-size:13px}
‎.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
‎.category{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;transition:.2s;box-shadow:0 5px 18px rgba(14,35,64,.04)}
‎.category:hover,.institution:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(14,35,64,.09)}
‎.icon{width:45px;height:45px;border-radius:14px;background:#edf4ff;display:grid;place-items:center;font-size:23px;margin-bottom:13px}
‎.category h3{margin:0 0 6px;font-size:16px}.category p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}
‎.stats{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
‎.stat{text-align:center;border-right:1px solid var(--line)}.stat:last-child{border:0}.stat b{display:block;font-size:24px;color:var(--blue)}.stat span{font-size:12px;color:var(--muted)}
‎.institutions{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
‎.institution{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;transition:.2s}
‎.photo{height:130px;background:linear-gradient(135deg,#dce9fa,#eef7f1);display:grid;place-items:center;font-size:38px}
‎.inbody{padding:15px}.tag{font-size:10px;color:var(--blue);background:#edf4ff;padding:5px 8px;border-radius:20px;display:inline-block}.inbody h3{font-size:15px;margin:10px 0 8px}.meta{font-size:11px;color:var(--muted);line-height:1.8}.profile{margin-top:10px;width:100%;border:1px solid #cbd9ec;background:#fff;color:var(--blue);border-radius:9px;padding:9px;font-weight:700}
‎.cta{background:linear-gradient(135deg,#eaf3ff,#eafaf4);border:1px solid #dbe8f5;border-radius:20px;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:20px}.cta h2{margin:0 0 7px}.cta p{margin:0;color:var(--muted);font-size:13px}
‎footer{background:#0b2340;color:#dbe6f4;padding:40px 0 22px}.footergrid{display:grid;grid-template-columns:2fr 1fr 1fr 1.4fr;gap:30px}.footergrid h3{color:#fff;font-size:14px}.footergrid a,.footergrid p{display:block;color:#b8c8da;font-size:12px;margin:9px 0}.copyright{border-top:1px solid rgba(255,255,255,.12);margin-top:25px;padding-top:15px;color:#91a7bf;font-size:11px}
‎
‎/* Dark Mode CSS */
‎body.dark{--bg:#0b1220;--text:#e8eef7;--muted:#a9b7c9;--card:#121c2d;--line:#25344a}
‎body.dark header,body.dark .searchbox,body.dark .stats,body.dark .institution,body.dark .category{background:#121c2d;color:#e8eef7}
‎body.dark .searchbox select,body.dark .searchbox input,body.dark .profile{background:#0e1726;color:#e8eef7;border-color:#2a3b53}
‎body.dark .cta{background:#101d2e;border-color:#2a3b53}
‎body.dark footer{background:#060c16}
‎body.dark .icon{background:#1a2b43}
‎body.dark .tag{background:#17335c}
‎body.dark .navlinks{color:#b9c7d8}
‎body.dark .navlinks a{color:#b9c7d8}
‎body.dark .theme-toggle, body.dark .lang-switch{background:#1a293d;color:#fff;border-color:#344a66}
‎
‎.location-panel{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;box-shadow:0 8px 28px rgba(14,35,64,.06)}
‎body.dark .location-panel{background:#121c2d}
‎.location-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
‎.location-grid select{width:100%;padding:13px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--text);font-size:13px}
‎body.dark .location-grid select{background:#0e1726;color:#e8eef7;border-color:#2a3b53}
‎.division-list{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}
‎.division-card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:17px;cursor:pointer;transition:.2s}
‎.division-card:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(14,35,64,.08)}
‎body.dark .division-card{background:#121c2d}
‎.division-card.active{border-color:#1769e0;box-shadow:0 0 0 2px rgba(23,105,224,.12)}
‎.division-card h3{margin:0 0 5px;font-size:15px}.division-card p{margin:0;color:var(--muted);font-size:11px}
‎.district-results{margin-top:18px;padding-top:18px;border-top:1px solid var(--line)}
‎.district-results h3{margin:0 0 12px;font-size:16px}
‎.district-chips{display:flex;flex-wrap:wrap;gap:8px}
‎.district-chip{border:1px solid #d9e3ef;background:#f7faff;color:#1b4f94;border-radius:20px;padding:8px 12px;font-size:12px;cursor:pointer}
‎body.dark .district-chip{background:#17263b;border-color:#30445d;color:#b9d5ff}
‎.location-note{font-size:11px;color:var(--muted);margin-top:10px}
‎
‎@media(max-width:900px){.navlinks{display:none}.grid{grid-template-columns:repeat(2,1fr)}.institutions{grid-template-columns:repeat(2,1fr)}.footergrid{grid-template-columns:1fr 1fr}h1{font-size:34px}.division-list{grid-template-columns:repeat(2,1fr)}.location-grid{grid-template-columns:repeat(2,1fr)}}
‎@media(max-width:600px){.nav{height:60px}.hero{padding:42px 0}.searchbox{display:grid;grid-template-columns:1fr 1fr}.searchbox select,.searchbox input,.searchbox button{width:100%}.searchbox input{grid-column:1/3}.searchbox button{grid-column:1/3}.grid{grid-template-columns:repeat(2,1fr);gap:10px}.category{padding:15px}.institutions{grid-template-columns:1fr 1fr;gap:10px}.photo{height:105px}.stats{grid-template-columns:1fr 1fr}.stat{border-right:0;padding:8px;border-bottom:1px solid var(--line)}.cta{display:block}.cta .btn{margin-top:18px}.footergrid{grid-template-columns:1fr 1fr}h1{font-size:29px}}
‎</style>
‎</head>
‎<body>
‎
‎<header>
‎  <div class="container nav">
‎    <!-- লোগো ও নাম (ছবি লাগাতে চাইলে <span class="logo-mark"> এর ভেতর <img src="logo.png"> বসাবেন) -->
‎    <a class="logo" href="#">
‎      <span class="logo-mark">⌂</span>
‎      <span>আমার প্রতিষ্ঠান<small style="display:block;font-size:9px;color:#6c7c91;font-weight:500">তথ্যই শক্তি • সেবা হবে সহজ</small></span>
‎    </a>
‎
‎    <!-- নেভিগেশন লিংকসমূহ -->
‎    <nav class="navlinks">
‎      <a href="#categories">বিভাগ</a>
‎      <a href="#institutions">প্রতিষ্ঠান</a>
‎      <a href="#areas">এলাকা</a>
‎      <a href="#about">আমাদের সম্পর্কে</a>
‎    </nav>
‎
‎    <!-- ডানপাশের বাটনসমূহ (প্রতিষ্ঠান যুক্ত করুন, ভাষা ও নাইট মোড) -->
‎    <div class="nav-right">
‎      <a class="btn btn-primary" href="#add">প্রতিষ্ঠান যুক্ত করুন</a>
‎      <select class="lang-switch" id="langSelect" aria-label="ভাষা পরিবর্তন">
‎        <option value="bn">BN</option>
‎        <option value="en">EN</option>
‎      </select>
‎      <button class="theme-toggle" id="themeToggle" aria-label="নাইট মোড" title="নাইট মোড">🌙</button>
‎    </div>
‎  </div>
‎</header>
‎
‎<main>
‎<section class="hero">
‎<div class="container hero-inner">
‎  <span class="badge">বাংলাদেশের প্রতিষ্ঠান ও সেবার তথ্যভান্ডার</span>
‎  <h1>আপনার এলাকার প্রতিষ্ঠান ও সেবা <span style="color:#42d59a">এক ক্লিকে খুঁজুন</span></h1>
‎  <p>শিক্ষা, মাদ্রাসা, স্বাস্থ্য, সরকারি প্রতিষ্ঠান, ব্যাংক ও স্থানীয় সেবা—ধীরে ধীরে সব তথ্য এক জায়গায়।</p>
‎  <div class="searchbox">
‎    <select><option>জেলা নির্বাচন করুন</option><option>নওগাঁ</option><option>ঢাকা</option></select>
‎    <select><option>উপজেলা নির্বাচন করুন</option><option>সাপাহার</option><option>সাভার</option></select>
‎    <input placeholder="প্রতিষ্ঠান বা সেবা খুঁজুন">
‎    <button class="btn btn-primary">🔍 খুঁজুন</button>
‎  </div>
‎  <div class="quick"><span>জনপ্রিয়: মাদ্রাসা</span><span>স্কুল</span><span>হাসপাতাল</span><span>সরকারি অফিস</span><span>ব্যাংক</span></div>
‎</div>
‎</section>
‎
‎<section id="categories">
‎<div class="container">
‎<div class="section-head"><div><h2>প্রতিষ্ঠান ও সেবার বিভাগ</h2><p>আপনার প্রয়োজন অনুযায়ী একটি বিভাগ বেছে নিন</p></div><a href="#" style="color:#1769e0;font-size:13px;font-weight:700">সব বিভাগ →</a></div>
‎<div class="grid">
‎  <div class="category"><div class="icon">🏫</div><h3>শিক্ষা প্রতিষ্ঠান</h3><p>স্কুল, কলেজ, বিশ্ববিদ্যালয় ও কারিগরি প্রতিষ্ঠান</p></div>
‎  <div class="category"><div class="icon">🕌</div><h3>মাদ্রাসা ও ইসলামিক</h3><p>কওমি, আলিয়া মাদ্রাসা ও ইসলামিক প্রতিষ্ঠান</p></div>
‎  <div class="category"><div class="icon">🏥</div><h3>স্বাস্থ্যসেবা</h3><p>হাসপাতাল, ক্লিনিক, ডায়াগনস্টিক ও অন্যান্য সেবা</p></div>
‎  <div class="category"><div class="icon">🏛️</div><h3>সরকারি সেবা</h3><p>সরকারি অফিস, ইউনিয়ন, উপজেলা ও নাগরিক সেবা</p></div>
‎  <div class="category"><div class="icon">🏦</div><h3>ব্যাংক ও আর্থিক সেবা</h3><p>ব্যাংক, বীমা ও আর্থিক প্রতিষ্ঠান</p></div>
‎  <div class="category"><div class="icon">💼</div><h3>চাকরি ও প্রশিক্ষণ</h3><p>প্রশিক্ষণ কেন্দ্র, কারিগরি ও কর্মমুখী শিক্ষা</p></div>
‎  <div class="category"><div class="icon">👥</div><h3>স্থানীয় সেবা</h3><p>আইনজীবী, পরিবহন, কমিউনিটি ও পেশাজীবী</p></div>
‎  <div class="category"><div class="icon">▦</div><h3>অন্যান্য সেবা</h3><p>প্রয়োজনীয় আরও প্রতিষ্ঠান ও সেবা</p></div>
‎</div>
‎</div>
‎</section>
‎
‎<section id="location-explorer">
‎<div class="container">
‎  <div class="section-head">
‎    <div><h2>বাংলাদেশের এলাকা অনুযায়ী খুঁজুন</h2><p>বিভাগ → জেলা → উপজেলা/থানা নির্বাচন করে প্রতিষ্ঠানের তথ্য খুঁজুন</p></div>
‎  </div>
‎  <div class="location-panel">
‎    <div class="location-grid">
‎      <select id="divisionSelect"><option value="">বিভাগ নির্বাচন করুন</option></select>
‎      <select id="districtSelect" disabled><option value="">আগে বিভাগ নির্বাচন করুন</option></select>
‎      <select id="upazilaSelect" disabled><option value="">আগে জেলা নির্বাচন করুন</option></select>
‎      <select id="serviceSelect"><option value="">প্রতিষ্ঠান/সেবা নির্বাচন</option><option>সব প্রতিষ্ঠান</option><option>শিক্ষা প্রতিষ্ঠান</option><option>মাদ্রাসা ও ইসলামিক</option><option>স্বাস্থ্যসেবা</option><option>সরকারি সেবা</option><option>ব্যাংক ও আর্থিক সেবা</option><option>চাকরি ও প্রশিক্ষণ</option><option>স্থানীয় সেবা</option></select>
‎    </div>
‎    <div class="location-note">বিভাগ বা জেলা কার্ডে ক্লিক করেও তালিকা দেখা যাবে। উপজেলা/থানার পূর্ণ তালিকা পরবর্তী ডেটা-সংযোগ ধাপে যুক্ত করা হবে।</div>
‎    <div class="division-list" id="divisionList"></div>
‎    <div class="district-results" id="districtResults" style="display:none">
‎      <h3 id="districtTitle">জেলার তালিকা</h3>
‎      <div class="district-chips" id="districtChips"></div>
‎    </div>
‎  </div>
‎</div>
‎</section>
‎
‎<section>
‎<div class="container">
‎<div class="stats">
‎<div class="stat"><b>৫,০০০+</b><span>লক্ষ্য: প্রতিষ্ঠান</span></div>
‎<div class="stat"><b>৬৪</b><span>জেলা</span></div>
‎<div class="stat"><b>৪৯৫</b><span>উপজেলা</span></div>
‎<div class="stat"><b>∞</b><span>সেবার সম্ভাবনা</span></div>
‎</div>
‎</div>
‎</section>
‎
‎<section id="institutions">
‎<div class="container">
‎<div class="section-head"><div><h2>সেবা ও জনপ্রিয় প্রতিষ্ঠান</h2><p>ডেমো ডেটা — ভবিষ্যতে Google Sheets থেকে স্বয়ংক্রিয়ভাবে আসবে</p></div><a href="#" style="color:#1769e0;font-size:13px;font-weight:700">সব প্রতিষ্ঠান →</a></div>
‎<div class="institutions">
‎  <div class="institution"><div class="photo">🏫</div><div class="inbody"><span class="tag">শিক্ষা</span><h3>আল-ফালাহ মডেল প্রতিষ্ঠান</h3><div class="meta">📍 সাপাহার, নওগাঁ<br>☎ 01XXX-XXXXXX</div><button class="profile">প্রোফাইল দেখুন</button></div></div>
‎  <div class="institution"><div class="photo">🕌</div><div class="inbody"><span class="tag">মাদ্রাসা</span><h3>আল-ফালাহ কওমি মাদ্রাসা</h3><div class="meta">📍 গোয়ালা, সাপাহার<br>☎ 01XXX-XXXXXX</div><button class="profile">প্রোফাইল দেখুন</button></div></div>
‎  <div class="institution"><div class="photo">🏥</div><div class="inbody"><span class="tag">স্বাস্থ্য</span><h3>আদর্শ হাসপাতাল</h3><div class="meta">📍 নওগাঁ সদর<br>☎ 02-XXXXXXX</div><button class="profile">প্রোফাইল দেখুন</button></div></div>
